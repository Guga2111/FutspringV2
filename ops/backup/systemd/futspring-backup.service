[Unit]
Description=Verified Futspring offsite database backup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/futspring-backup/backup.py daily
TimeoutStartSec=32min
KillMode=control-group
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/futspring-backup /var/lib/node_exporter/textfile_collector
