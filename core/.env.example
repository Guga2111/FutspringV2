# Banco de Dados (produção: Supabase pooler; o deploy não usa DDL_AUTO, o schema é do Flyway)
DB_URL=jdbc:postgresql://localhost:5432/futspringdb
DB_USERNAME=futspringuser
DB_PASSWORD=your_secure_password_here

# JWT — gere um segredo forte: openssl rand -base64 64
JWT_SECRET=your_very_long_and_secure_jwt_secret_here
JWT_EXPIRATION_MS=604800000

# Origens permitidas para WebSocket (separadas por vírgula se mais de uma)
ALLOWED_ORIGINS=https://futspring.luisgosampaio.com

# URL pública do frontend (links enviados por e-mail, ex.: redefinição de senha)
APP_URL=https://futspring.luisgosampaio.com
# URL pública da API (o provedor de e-mail chama o descadastro em um clique, header List-Unsubscribe)
API_URL=https://futspring.luisgosampaio.com/api

# E-mail (Resend) — API key em resend.com > API Keys (permissão "Sending access")
RESEND_API_KEY=re_your_api_key_here
# Remetente: precisa ser do domínio verificado no Resend
MAIL_FROM=Futspring <no-reply@futspring.luisgosampaio.com>

# Web Push (VAPID) — par P-256 em base64url, gerado uma vez: npx web-push generate-vapid-keys
# Sem a chave privada o push fica desligado. Trocar o par invalida todas as inscrições dos aparelhos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@futspring.luisgosampaio.com

# Pix de cobrança da assinatura (área Assinatura do criador). Sem a chave, a tela não mostra Pix.
# Chave: telefone (DDD + número; o +55 é acrescentado), e-mail ou chave aleatória. CPF/CNPJ não.
# NAME aparece inteiro na tela; dentro do código Pix vão MERCHANT_NAME (opcional, até 25 caracteres; sem ele, NAME)
# e CITY (até 15), sem acento e em maiúsculas. Fora do formato, a API não sobe.
BILLING_PIX_KEY=
BILLING_PIX_NAME=
BILLING_PIX_MERCHANT_NAME=
BILLING_PIX_CITY=

# Spring Profile — use 'prod' em produção para desativar o DataInitializer
SPRING_PROFILES_ACTIVE=prod

# Deploy (scripts/deploy.sh + docker-compose.prod.yml)
# Porta do host onde a API escuta (o nginx faz proxy para ela)
API_PORT=8081
# Opcional: backup antes das migrations do Flyway. URL libpq do Supabase *session pooler* (porta 5432)
# postgresql://postgres.<ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
PG_DUMP_URL=
